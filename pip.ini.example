; Windows: copy to %APPDATA%\pip\pip.ini
; macOS/Linux: copy to ~/.pip/pip.conf  (section [global] same)
;
; Optional global pip mirror. requirements-mcp.txt already sets Tsinghua for
; `pip install -r requirements-mcp.txt`; use this file if you want all pip installs mirrored.
[global]
index-url = https://pypi.tuna.tsinghua.edu.cn/simple
trusted-host = pypi.tuna.tsinghua.edu.cn
timeout = 120
